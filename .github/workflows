name: Enviar Resumo de Notícias

on:
  schedule:
    # Roda todo dia às 8:00 da manhã no horário UTC (ajuste o cron para o seu fuso)
    - cron: '0 11 * * *' 
  workflow_dispatch: # Permite testar o botão manualmente na interface do GitHub

jobs:
  run-python-script:
    runs-on: ubuntu-latest
    steps:
      - name: Copiar código do repositório
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Instalar dependências
        run: |
          pip install requests beautifulsoup4

      - name: Executar o script de notícias
        run: python noticias.py
        env:
          # Se você usar alguma API ou token secreto, coloque aqui de forma segura
          WHATSAPP_TOKEN: ${{ secrets.WHATSAPP_TOKEN }}
